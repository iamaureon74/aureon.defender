  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; connect-src https: http://127.0.0.1:11434 http://localhost:11434; base-uri 'none'; form-action 'none'"
  },
  "commands": {
    "panic": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Panic: close every tab, clear history, drop the tunnel"
    },
    "rotate-fingerprint": {
      "description": "Give every site a new fingerprint"
    }
  },
  "web_accessible_resources": [
